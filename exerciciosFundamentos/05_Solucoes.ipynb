   "source": [
    "# 1\n",
    "A = {1, 2, 3, 4, 5}\n",
    "B = {4, 5, 6, 7, 8}\n",
    "\n",
    "print(f\"Conjunto união: {A.union(B)}\")\n",
    "print(f\"Conjunto interceção: {A.intersection(B)}\")\n",
    "print(f\"Conjunto diferença: {A.difference(B)}\")\n",
    "print(f\"A é subconjunto de B?: {A.issubset(B)}\")\n",
    "\n"
   ]
  }
